{
  "name": "moneybook",
  "type": "module",
  "version": "1.1.7",
  "description": "money book backend server",
  "main": "src/main.ts",
  "scripts": {
    "init": "bun install || npx -y bun install",
    "update": "bun update || npx -y bun update",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "start": "bun --watch src/main -d mysql://root:root@nas.internal:3306/moneybook -a 127.0.0.1 -p 8000",
    "build": "bun build.js || node build.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.2",
    "bun": "^1.3.9",
    "prisma": "^7.3.0"
  }
}
