{
  "name": "moneybook",
  "type": "module",
  "version": "1.2.0",
  "description": "money book backend server",
  "main": "src/main.ts",
  "scripts": {
    "init": "bun install || npx -y bun install",
    "update": "bun update || npx -y bun update",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "start": "bun --watch src/main -d mysql://root:root@nas.internal:3306/moneybook -a 127.0.0.1 -p 8000",
    "build": "bun build.js || node build.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@prisma/adapter-mariadb": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "commander": "^14.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "bun": "^1.3.11",
    "prisma": "^7.5.0"
  }
}